<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No network: DebtID runs entirely on the device. The QR scanner library asks for
         network access only for Google's telemetry; the scanner itself runs in Play services. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <!-- Unlock with fingerprint or face (Android 10+); the page keeps the PIN as the fallback -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Due-date reminders: notifications (asked only when the person turns reminders on)
         and scheduling them again after the phone restarts -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.DebtID"
        android:allowBackup="false"
        android:supportsRtl="false">

        <!-- Download the Google Play services QR scanner module along with the app -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize">
            <!-- Receive a code shared from another app (WhatsApp, email…) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- App icons the person can choose in Settings: exactly one of these launcher entries is
             enabled at a time (A is the default). They all open MainActivity. -->
        <activity-alias
            android:name=".IconeA"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconeACores"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_a_cores"
            android:roundIcon="@mipmap/ic_launcher_a_cores"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconeC"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_c"
            android:roundIcon="@mipmap/ic_launcher_c"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconeCCores"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_c_cores"
            android:roundIcon="@mipmap/ic_launcher_c_cores"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The app's own reminder alarms: private, no other app can send to it -->
        <receiver android:name=".AlarmeReceiver" android:exported="false" />
        <!-- Only system broadcasts (restart and app update), which other apps cannot send -->
        <receiver android:name=".ReinicioReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
